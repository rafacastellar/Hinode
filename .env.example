# Banco de Dados MySQL (mysql2/promise)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=hinode_db

# Segredo para assinatura de cookies e tokens de sessão
SESSION_SECRET=chave_secreta_minimo_32_caracteres_aleatorios_1234567890
