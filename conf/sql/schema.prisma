datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// Hinode - Sistema de Gestão de Dojos
// Espelho do Esquema V4 (conf/sql/HinodeV4.sql) para Documentação e ERD
// NOTA: O runtime do backend utiliza driver mysql2/promise (sem Prisma ORM).
// =============================================================================

// =======================================================
// 1. ENTIDADES BASE (SEM ENDEREÇO DIRETO NA TABELA)
// =======================================================

model Academia {
  id_academia   Int                @id @default(autoincrement())
  nome          String             @db.VarChar(255)
  nome_fantasia String?            @db.VarChar(255)
  cnpj          String             @unique @db.VarChar(20)
  inscr_est     String?            @db.VarChar(50)
  telefone      String?            @db.VarChar(20)

  endereco      Endereco_Academia?
  usuarios      Usuario_Academia[]
  turmas        Treino_Turma[]
  eventos       Evento[]
}

model Usuario {
  id_usuario      Int                @id @default(autoincrement())
  nome            String             @db.VarChar(255)
  tipo_documento  String             @default("CPF") @db.VarChar(20)
  cpf             String             @unique @db.VarChar(30)
  pais_origem     String             @default("Brasil") @db.VarChar(60)
  data_nascimento DateTime           @db.Date
  genero          String             @default("M") @db.Char(1)
  email           String             @unique @db.VarChar(255)
  senha_hash      String             @db.VarChar(255)
  telefone        String?            @db.VarChar(20)

  endereco        Endereco_Usuario?
  academias       Usuario_Academia[]
  responsavel     Responsavel?
  professor       Professor?
  aluno           Aluno?
}

model Perfil {
  id_perfil        Int                      @id @default(autoincrement())
  role             String                   @unique @db.VarChar(50)
  perfis_academias Usuario_Academia_Perfil[]
}

// =======================================================
// 2. TABELAS ESPECÍFICAS DE ENDEREÇO (RELAÇÃO 1:1)
// =======================================================

model Endereco_Academia {
  id_academia Int      @id
  logradouro  String   @db.VarChar(255)
  numero      String?  @db.VarChar(20)
  complemento String?  @db.VarChar(100)
  bairro      String?  @db.VarChar(100)
  cidade      String   @db.VarChar(100)
  uf          String   @db.Char(2)
  cep         String   @db.VarChar(20)

  academia    Academia @relation(fields: [id_academia], references: [id_academia], onDelete: Cascade)
}

model Endereco_Usuario {
  id_usuario  Int     @id
  logradouro  String  @db.VarChar(255)
  numero      String? @db.VarChar(20)
  complemento String? @db.VarChar(100)
  bairro      String? @db.VarChar(100)
  cidade      String  @db.VarChar(100)
  uf          String  @db.Char(2)
  cep         String  @db.VarChar(20)

  usuario     Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
}

// =======================================================
// 3. RELACIONAMENTOS GERAIS DE USUÁRIO E SESSÃO
// =======================================================

model Usuario_Academia {
  id_usuario       Int
  id_academia      Int

  usuario          Usuario                   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  academia         Academia                  @relation(fields: [id_academia], references: [id_academia], onDelete: Cascade)
  perfis           Usuario_Academia_Perfil[]
  sessoes          Sessao[]

  @@id([id_usuario, id_academia])
}

model Usuario_Academia_Perfil {
  id_usuario       Int
  id_academia      Int
  id_perfil        Int

  usuario_academia Usuario_Academia @relation(fields: [id_usuario, id_academia], references: [id_usuario, id_academia], onDelete: Cascade)
  perfil           Perfil           @relation(fields: [id_perfil], references: [id_perfil], onDelete: Cascade)

  @@id([id_usuario, id_academia, id_perfil])
}

model Sessao {
  id_sessao        BigInt           @id @default(autoincrement())
  id_usuario       Int
  id_academia      Int
  token_hash       String           @unique(map: "uq_sessao_token_hash") @db.Char(64)
  criado_em        DateTime         @default(now())
  expira_em        DateTime
  revogada_em      DateTime?
  ip               String?          @db.VarChar(45)
  user_agent       String?          @db.VarChar(255)

  usuario_academia Usuario_Academia @relation(fields: [id_usuario, id_academia], references: [id_usuario, id_academia], onDelete: Cascade)

  @@index([id_usuario, id_academia], map: "idx_sessao_usuario_academia")
  @@index([expira_em], map: "idx_sessao_expira_em")
}

// =======================================================
// 4. HERANÇA DE USUÁRIO (OVERLAPPING)
// =======================================================

model Responsavel {
  id_usuario      Int                 @id
  grau_parentesco String?             @db.VarChar(50)
  financeiro      Boolean?

  usuario         Usuario             @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  alunos          Responsavel_Aluno[]
}

model Professor {
  id_usuario             Int                   @id
  n_federacao            String?               @db.VarChar(50)
  grau_faixa             String?               @db.VarChar(50)

  usuario                Usuario               @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  alunos_supervisionados Aluno[]               @relation("ProfessorResponsavel")
  treinos                Professor_Treino[]
  inscricoes             Inscricao_Evento[]
  graduacoes_homologadas Historico_Graduacao[] @relation("ProfessorHomologador")
}

model Aluno {
  id_usuario               Int                   @id
  matricula                String?               @db.VarChar(50)
  peso                     Decimal?              @db.Decimal(5, 2)
  categoria                String?               @db.VarChar(50)
  n_federacao              String?               @db.VarChar(50)
  status_federacao         String?               @db.VarChar(50)
  data_primeira_graduacao  DateTime?             @db.Date
  data_inicio              DateTime?             @db.Date
  graduacao_atual          String?               @db.VarChar(50)
  grupo_especial_aspirante String?               @db.VarChar(50)
  id_professor_responsavel Int

  usuario                  Usuario               @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  professor_responsavel    Professor             @relation("ProfessorResponsavel", fields: [id_professor_responsavel], references: [id_usuario], onDelete: Restrict)
  responsaveis             Responsavel_Aluno[]
  treinos                  Aluno_Treino[]
  inscricoes               Inscricao_Evento[]
  classificacoes           Classificacao[]
  historicos               Historico_Graduacao[]
}

model Responsavel_Aluno {
  id_responsavel Int
  id_aluno       Int

  responsavel    Responsavel @relation(fields: [id_responsavel], references: [id_usuario], onDelete: Cascade)
  aluno          Aluno       @relation(fields: [id_aluno], references: [id_usuario], onDelete: Cascade)

  @@id([id_responsavel, id_aluno])
}

// =======================================================
// 5. TREINOS E TURMAS
// =======================================================

model Treino_Turma {
  id_treino      Int                @id @default(autoincrement())
  id_academia    Int
  descricao      String?            @db.VarChar(255)
  horario_inicio DateTime?          @db.Time
  horario_fim    DateTime?          @db.Time
  dia_semana     String?            @db.VarChar(50)

  academia       Academia           @relation(fields: [id_academia], references: [id_academia], onDelete: Cascade)
  professores    Professor_Treino[]
  alunos         Aluno_Treino[]
}

model Professor_Treino {
  id_professor Int
  id_treino    Int

  professor    Professor    @relation(fields: [id_professor], references: [id_usuario], onDelete: Cascade)
  treino       Treino_Turma @relation(fields: [id_treino], references: [id_treino], onDelete: Cascade)

  @@id([id_professor, id_treino])
}

model Aluno_Treino {
  id_aluno  Int
  id_treino Int

  aluno     Aluno        @relation(fields: [id_aluno], references: [id_usuario], onDelete: Cascade)
  treino    Treino_Turma @relation(fields: [id_treino], references: [id_treino], onDelete: Cascade)

  @@id([id_aluno, id_treino])
}

// =======================================================
// 6. EVENTOS E CAMPEONATOS
// =======================================================

model Evento {
  id_evento   Int                @id @default(autoincrement())
  id_academia Int
  nome        String             @db.VarChar(255)
  edicao      String?            @db.VarChar(50)
  data_inicio DateTime?          @db.Date

  academia    Academia           @relation(fields: [id_academia], references: [id_academia], onDelete: Cascade)
  endereco    Endereco_Evento?
  inscricoes  Inscricao_Evento[]
  campeonato  Campeonato?
  graduacao   Graduacao_Evento?
}

model Endereco_Evento {
  id_evento   Int     @id
  logradouro  String  @db.VarChar(255)
  numero      String? @db.VarChar(20)
  complemento String? @db.VarChar(100)
  bairro      String? @db.VarChar(100)
  cidade      String  @db.VarChar(100)
  uf          String  @db.Char(2)
  cep         String  @db.VarChar(20)

  evento      Evento  @relation(fields: [id_evento], references: [id_evento], onDelete: Cascade)
}

model Inscricao_Evento {
  id_inscricao          Int        @id @default(autoincrement())
  id_aluno              Int?
  id_professor          Int?
  id_evento             Int
  status_inscricao      String     @default("Pendente") @db.VarChar(50)
  valor                 Decimal?   @db.Decimal(10, 2)

  aluno                 Aluno?     @relation(fields: [id_aluno], references: [id_usuario], onDelete: Cascade)
  professor             Professor? @relation(fields: [id_professor], references: [id_usuario], onDelete: Cascade)
  evento                Evento     @relation(fields: [id_evento], references: [id_evento], onDelete: Cascade)

  @@unique([id_evento, id_aluno], map: "uq_inscricao_evento_aluno")
  @@unique([id_evento, id_professor], map: "uq_inscricao_evento_professor")
}

model Campeonato {
  id_evento              Int             @id
  tipo_campeonato        String?         @db.VarChar(100)
  classificacao_academia String?         @db.VarChar(100)
  limite_graduacao       String?         @db.VarChar(100)
  limite_grupo           String?         @db.VarChar(100)
  data_inicio_inscricao  DateTime?       @db.Date
  data_fim_inscricao     DateTime?       @db.Date

  evento                 Evento          @relation(fields: [id_evento], references: [id_evento], onDelete: Cascade)
  classificacoes         Classificacao[]
}

model Classificacao {
  id_classificacao    Int        @id @default(autoincrement())
  id_campeonato       Int
  id_aluno            Int
  classificacao_aluno String?    @db.VarChar(50)
  qtd_lutas           Int        @default(0)
  qtd_vitorias        Int        @default(0)

  campeonato          Campeonato @relation(fields: [id_campeonato], references: [id_evento], onDelete: Cascade)
  aluno               Aluno      @relation(fields: [id_aluno], references: [id_usuario], onDelete: Cascade)

  @@unique([id_campeonato, id_aluno], map: "uq_classificacao_campeonato_aluno")
}

model Graduacao_Evento {
  id_evento                           Int                   @id
  tipo_graduacao                      String?               @default("Troca de Faixa") @db.VarChar(100)
  status                              String?               @default("Agendado") @db.VarChar(50)
  faixa_inicio                        String                @default("Branca") @db.VarChar(50)
  faixa_fim                           String                @default("Marrom") @db.VarChar(50)
  tempo_minimo_judo_meses             Int?                  @default(0)
  tempo_minimo_ultima_graduacao_meses Int?                  @default(0)
  taxa_graduacao                      Decimal?              @default(0.00) @db.Decimal(10, 2)
  data_inicio_inscricao               DateTime?             @db.Date
  data_fim_inscricao                  DateTime?             @db.Date
  requisitos                          String?               @db.Text

  evento                              Evento                @relation(fields: [id_evento], references: [id_evento], onDelete: Cascade)
  historicos                          Historico_Graduacao[]
}

// =======================================================
// 7. HISTÓRICO DE GRADUAÇÃO (IMUTÁVEL / INSERT-ONLY)
// =======================================================

model Historico_Graduacao {
  id_historico             Int               @id @default(autoincrement())
  id_evento_graduacao      Int?
  id_aluno                 Int
  id_professor_homologador Int
  data_graduacao           DateTime?         @db.Date
  associacao               String?           @db.VarChar(100)
  faixa                    String?           @db.VarChar(50)

  evento_graduacao         Graduacao_Evento? @relation(fields: [id_evento_graduacao], references: [id_evento], onDelete: Restrict)
  aluno                    Aluno             @relation(fields: [id_aluno], references: [id_usuario], onDelete: Restrict)
  professor_homologador    Professor         @relation("ProfessorHomologador", fields: [id_professor_homologador], references: [id_usuario], onDelete: Restrict)
}

// =======================================================
// 8. LOG DE AUDITORIA (LGPD / INSERT-ONLY)
// =======================================================

model Log_Auditoria {
  id_log       BigInt   @id @default(autoincrement())
  id_academia  Int?
  id_usuario   Int?
  acao         String   @db.VarChar(100)
  entidade     String?  @db.VarChar(100)
  id_entidade  String?  @db.VarChar(64)
  dados_antes  Json?
  dados_depois Json?
  ip           String?  @db.VarChar(45)
  criado_em    DateTime @default(now())

  @@index([id_academia, criado_em], map: "idx_log_academia_data")
  @@index([id_usuario, criado_em], map: "idx_log_usuario_data")
  @@index([entidade, id_entidade], map: "idx_log_entidade")
}
